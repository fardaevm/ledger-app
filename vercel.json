{
  "functions": {
    "api/index.py": {
      "includeFiles": "finance-agent/app/**",
      "excludeFiles": "{.env,**/.env,.env.*,.claude/**,.vercel/**,**/.venv/**,**/__pycache__/**,**/.pytest_cache/**,node_modules/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
