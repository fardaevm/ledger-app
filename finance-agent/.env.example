# Local development only. On Vercel these are Project Settings → Environment Variables.

# Anthropic API key — used for the assistant's model calls. Server-side only: never give it
# a VITE_ prefix, or Vite would build it into the page for every visitor.
ANTHROPIC_API_KEY=sk-ant-...

# Who may use the assistant (comma-separated). Sign-up is open, so this keeps strangers from
# spending your Anthropic credits. Unset = nobody.
ASSISTANT_ALLOWED_EMAILS=you@example.com,partner@example.com

# Same Supabase project as the ledger-app frontend. Optional on Vercel: the function falls
# back to the app's VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Only needed if something on ANOTHER origin must call the API from a browser. The app
# itself (deployed, or through Vite's /api proxy locally) is same-origin and needs nothing.
# ALLOWED_ORIGINS=
